# Local port only. Render supplies PORT automatically in production.
PORT=5000

# Deployment setting: create this in the hosting provider's Environment tab.
# Never commit the real connection string to Git.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/YOUR_DATABASE_NAME?retryWrites=true&w=majority

# Deployment setting: use the public URL assigned by the hosting provider.
BASE_URL=http://localhost:5000

# Deployment settings: choose a strong value for both in production.
ADMIN_USER=change-this-user
ADMIN_PASS=change-this-password

# Optional: comma-separated frontend URL(s) allowed to call this API.
# CORS_ORIGIN=https://your-frontend.example.com
